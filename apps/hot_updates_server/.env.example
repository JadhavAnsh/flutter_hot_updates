# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hot_updates

# Redis
REDIS_URL=redis://localhost:6379

# Backblaze B2 S3-compatible storage
S3_ENDPOINT=https://s3.us-west-000.backblazeb2.com
S3_REGION=us-west-000
S3_ACCESS_KEY_ID=your_b2_key_id
S3_SECRET_ACCESS_KEY=your_b2_application_key
S3_BUCKET=hot-updates-dev
S3_PUBLIC_BASE_URL=https://f000.backblazeb2.com/file/hot-updates-dev

# Private by default (false): clients receive short-lived presigned download
# URLs and the bucket can stay private. Set to true only for a public CDN bucket.
S3_PUBLIC_ACCESS=false
# TTL (seconds) of presigned download URLs injected into served manifests.
S3_DOWNLOAD_URL_TTL=900

# --- Local dev with MinIO (docker compose up minio createbuckets) ---
# Uncomment to run against the bundled MinIO instead of real Backblaze:
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_BUCKET=hot-updates-dev
# S3_PUBLIC_BASE_URL=http://localhost:9000/hot-updates-dev
# S3_PUBLIC_ACCESS=false

# Server
PORT=3000

# Trusted proxy hops in front of the API (0 = none). Required for correct
# per-IP rate limiting behind a CDN or reverse proxy.
TRUST_PROXY_HOPS=0

# Admin token for project creation (POST /v1/projects)
ADMIN_TOKEN=change_me_admin_secret

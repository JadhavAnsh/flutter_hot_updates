generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id         String    @id @default(uuid())
  name       String
  slug       String    @unique
  apiKeyHash String
  publicKey  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  releases   Release[]

  @@map("projects")
}

model Release {
  id         String   @id @default(uuid())
  projectId  String
  appVersion String
  platform   String
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  patches    Patch[]

  @@unique([projectId, appVersion, platform])
  @@index([projectId, platform, appVersion])
  @@map("releases")
}

model Patch {
  id              String    @id @default(uuid())
  releaseId       String
  patchNumber     Int
  bundleUrl       String
  bundleSha256    String
  bundleSizeBytes BigInt
  manifestData    Json
  signature       String
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
  publishedAt     DateTime?
  release         Release   @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, patchNumber])
  @@index([releaseId, status])
  @@map("patches")
}

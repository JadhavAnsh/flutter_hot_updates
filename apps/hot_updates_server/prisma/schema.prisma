generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id         String    @id @default(uuid())
  name       String
  slug       String    @unique
  apiKeyHash String
  publicKey  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  releases   Release[]
  devices    Device[]
  events     Event[]

  @@map("projects")
}

model Release {
  id         String   @id @default(uuid())
  projectId  String
  appVersion String
  platform   String
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  patches    Patch[]

  @@unique([projectId, appVersion, platform])
  @@index([projectId, platform, appVersion])
  @@map("releases")
}

model Patch {
  id              String    @id @default(uuid())
  releaseId       String
  patchNumber     Int
  bundleUrl       String
  // Object-store key of the uploaded bundle. Nullable: rows created before this
  // column existed have none. Used to presign short-lived download URLs and to
  // delete the object on patch/release/project removal.
  bundleKey       String?
  bundleSha256    String
  bundleSizeBytes BigInt
  manifestData    Json
  signature       String
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
  publishedAt     DateTime?
  release         Release   @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  installations   Installation[]

  @@unique([releaseId, patchNumber])
  @@index([releaseId, status])
  @@map("patches")
}

model Device {
  id            String         @id @default(uuid())
  projectId     String
  deviceId      String
  platform      String
  appVersion    String
  activePatch   Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  installations Installation[]

  @@unique([projectId, deviceId])
  @@index([projectId, platform, appVersion])
  @@map("devices")
}

model Installation {
  id        String   @id @default(uuid())
  deviceId  String
  patchId   String
  status    String
  errorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  patch     Patch    @relation(fields: [patchId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([patchId, status])
  @@map("installations")
}

model Event {
  id          String   @id @default(uuid())
  projectId   String
  deviceId    String?
  type        String
  patchNumber Int?
  appVersion  String?
  platform    String?
  payload     Json?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, type, createdAt])
  @@map("events")
}
